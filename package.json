{
  "name": "agentdock",
  "version": "1.0.0",
  "description": "Self-hosted agent runtime with memory, tools, and multi-channel messaging.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "reset:admin": "tsx src/reset-admin.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:prompt-characterization": "tsx container/agent-runner/tests/prompt-characterization.test.ts",
    "test:memory-timeout": "tsx src/memory-agent-timeout.test.ts",
    "test:memory-lanes": "tsx src/memory-lanes.test.ts",
    "test:memory-write-queue": "tsx src/memory-write-queue.test.ts",
    "test:external-knowledge": "tsx src/external-knowledge.test.ts",
    "test:memory-search": "tsx src/memory-search.test.ts",
    "test:memory-retention": "tsx src/memory-retention.test.ts",
    "test:session-list-query": "tsx src/session-list-query.test.ts",
    "test:session-pagination-smoke": "tsx scripts/session-pagination-smoke.ts",
    "test:context-conformance": "tsx container/agent-runner/tests/context-conformance.test.ts",
    "test:runner-contracts": "tsx container/agent-runner/tests/runner-contract.test.ts",
    "test:steering-feishu": "tsx src/steering-feishu-improvements.test.ts",
    "test:feishu-conversation-mode": "tsx src/feishu-conversation-mode.test.ts",
    "test:im-outbox": "tsx src/im-outbox.test.ts",
    "dev:all": "npx concurrently --timestamp-format \"yyyy-MM-dd HH:mm:ss.SSS\" -n backend,frontend -c blue,green \"npm run dev\" \"npm run dev:web\"",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "build:all": "npm run build && npm run build:web",
    "install:desktop": "npm --prefix desktop install",
    "dev:desktop": "npm run build:all && npm --prefix container/agent-runner-core run build && npm --prefix container/agent-runner run build && npm --prefix desktop run build && npm --prefix desktop start",
    "build:desktop": "npm run build:all && npm --prefix container/agent-runner-core run build && npm --prefix container/agent-runner run build && npm --prefix desktop run build",
    "pack:desktop": "npm run build:desktop && npm --prefix desktop run pack",
    "dist:desktop": "npm run build:desktop && npm --prefix desktop run dist:mac",
    "dist:desktop:arm64": "npm run build:desktop && npm --prefix desktop run dist:mac:arm64"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.5.0",
    "grammy": "^1.40.0",
    "hono": "^4.11.9",
    "https-proxy-agent": "^8.0.0",
    "node-pty": "^1.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "proxy-agent": "^6.5.0",
    "qrcode": "^1.5.4",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riba2534/agentdock.git"
  },
  "homepage": "https://github.com/riba2534/agentdock#readme",
  "bugs": {
    "url": "https://github.com/riba2534/agentdock/issues"
  },
  "author": "riba2534",
  "keywords": [
    "agent-runtime",
    "agentdock",
    "ai-agent",
    "self-hosted",
    "feishu",
    "lark",
    "telegram",
    "chatbot",
    "docker",
    "mcp"
  ]
}
